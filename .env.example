# =============================================================================
# PRIMARY CONFIGURATION - Google Gemini (required for all AI features)
# =============================================================================

# Gemini API key from AI Studio (https://aistudio.google.com/apikey)
# Required for TTS, STT, and LLM features
GEMINI_API_KEY=

# Google service account credentials for Drive/Docs access
# Path to a service account JSON file (chmod 600 for security)
# Required for scribe and docs_chat modes
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# REMOTE CONTROL - Mode switching from phone/web
# =============================================================================

# Remote control endpoint for mode switching (Sachin's phone -> robot)
# Default: https://creators-ecosystem.de (production)
REACHY_CONTROL_URL=https://creators-ecosystem.de

# Authentication token for the control endpoint (required)
REACHY_CONTROL_TOKEN=

# How often to poll the control endpoint (seconds)
REACHY_CONTROL_POLL_INTERVAL=3.0

# Return to idle if offline for this long (seconds)
REACHY_CONTROL_OFFLINE_TIMEOUT=30.0

# =============================================================================
# PROVIDER SETTINGS - Voice configuration
# =============================================================================

# TTS provider: gemini (default), xai, or deepgram
TTS_PROVIDER=gemini

# STT provider: gemini (default) or deepgram
STT_PROVIDER=gemini

# Voice for TTS (provider-specific)
# Gemini voices: Kore, Charon, Fenrir, Aoede, Puck, Leda, Orus, Zephyr
# xAI voices: ara, eve, leo, rex, sal
TTS_VOICE=Kore

# Language code for TTS (BCP-47, e.g., en, es, fr)
TTS_LANGUAGE=en

# =============================================================================
# GEMINI MODEL CONFIGURATION - Override default models
# =============================================================================

# TTS model (verified working: gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# STT model for batch transcription (verified: gemini-3.5-transcribe)
# Note: Response structure is {audioTranscription: {text}}, not {text}
GEMINI_STT_MODEL=gemini-3.5-transcribe

# STT model for live streaming transcription
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live

# Live conversational model for bidirectional audio
# Also available: gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_MODEL=gemini-3.8-live

# Chat/LLM model for text generation
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Custom vocabulary for STT (comma-separated)
# Helps with name recognition - "Reachy" otherwise misheard as "Richie"
STT_CUSTOM_VOCABULARY=Reachy,Reachy Mini,Grok,Grok Bot,Sachin

# =============================================================================
# FALLBACK PROVIDERS - Optional, used when Gemini fails
# =============================================================================

# xAI API key for Grok TTS fallback
# Note: Requires a funded API key (not OAuth subscription tokens)
# A 403 error means the key lacks TTS permission
XAI_API_KEY=

# Deepgram API key for TTS/STT fallback
DEEPGRAM_API_KEY=

# =============================================================================
# GROK BOT WEBHOOK - Chief of Staff integration (optional)
# =============================================================================

# Grok Bot routine webhook (from Routines → When to run → Webhook)
# Treat URL and key as secrets. Never commit them.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=

# =============================================================================
# MCP SERVER - For Grok Bot custom connector (optional)
# =============================================================================

# Public base URL of the MCP tunnel. Required once tunneled.
# Example: https://your-tunnel.example
PUBLIC_BASE_URL=

# MCP bind address. Tunnel this port to the public internet.
# Keep 127.0.0.1 when the tunnel runs on this machine; use 0.0.0.0 only if it runs elsewhere.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# MCP authentication token (required for MCP to start)
# Grok Bot must send it as "Authorization: Bearer <token>" or ?token=<token>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
