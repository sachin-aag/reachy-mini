# Grok Bot chief-of-staff routine webhook (from Routines → When to run → Webhook)
# Treat URL and key as secrets. Never commit them.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=

# Public base URL of the MCP tunnel. Required once tunneled: MCP rejects other Host headers.
# Example: https://your-tunnel.example
PUBLIC_BASE_URL=

# MCP bind (Grok Bot custom connector). Tunnel this port to the public internet.
# Keep 127.0.0.1 when the tunnel runs on this machine; use 0.0.0.0 only if it runs elsewhere.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Required. Grok Bot must send it as "Authorization: Bearer <token>" or ?token=<token>.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Optional TTS for speak(). Grok Voice if XAI_API_KEY is set; else Deepgram.
XAI_API_KEY=
GROK_VOICE=eve
DEEPGRAM_API_KEY=
